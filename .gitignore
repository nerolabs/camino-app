# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# macOS/editor accidental duplicates ("File 2.ext" — note the space before the number)
* [0-9].ts
* [0-9].tsx

# test artifacts
playwright-report/
test-results/

# Playwright captured auth state (contains a live staging session)
tests-e2e/.auth/
docs/store-assets/clean/

# Unpublished LinkedIn drafts — never commit to the public repo
linkedin-drafts/

# Marketing-assistant artifacts — the lead-gen operation's activity (targeted threads,
# drafts, posting ledger) must never reach the public repo. Tool code + spec stay public.
marketing/leads/
marketing/weekly/
marketing/state/
marketing/ledger.csv
marketing/fb-inbox.txt
marketing/leads.config.json

# Internal / AI-session working docs — kept LOCAL, out of the public repo (this repo is a
# public engineering exhibit). These stay on disk for the dev workflow; they are not published.
CLAUDE.md
AGENTS.md
HANDOFF.md
TODO.md
.claude/
